# ===== Сервер =====
PORT=4000
# Секрет для подписи JWT-токенов (поменяйте на свой случайный)
JWT_SECRET=change-me-to-a-long-random-string

# Разрешённый источник фронтенда (GitHub Pages URL)
# Пример: https://talgar0004kg.github.io
CORS_ORIGIN=*

# ===== DeepSeek =====
DEEPSEEK_API_KEY=sk-ваш-ключ
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== WhatsApp (whatsapp-web.js) =====
# true — включить отправку уведомлений в WhatsApp (нужен отдельный номер).
# При первом запуске в консоли появится QR-код — отсканируйте его в WhatsApp.
WHATSAPP_ENABLED=false

# ===== Защита от спама =====
# Максимум сообщений в чат от одного IP в минуту (контроль расходов DeepSeek)
RATE_LIMIT_PER_MIN=20
