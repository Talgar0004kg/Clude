{
  "name": "OpenHands (Gemini)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "OpenHands UI",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "cd openhands && cp -n .env.example .env || true"
}
