# ── Локальная LLM (Ollama) ──────────────────────────────────
# OpenHands ходит в LLM через LiteLLM. Для локальной Ollama префикс ollama/.
LLM_MODEL=ollama/llama3.2:3b

# Адрес локального сервера Ollama. OpenHands запускается в Docker, поэтому
# из контейнера хост доступен по host.docker.internal (а не localhost).
LLM_BASE_URL=http://host.docker.internal:11434

# Ollama не требует ключа — оставьте заглушку (LiteLLM хочет непустое значение).
LLM_API_KEY=ollama

# ── Версии образов OpenHands ────────────────────────────────
# Актуальные теги: https://github.com/All-Hands-AI/OpenHands/releases
OPENHANDS_VERSION=latest
AGENT_SERVER_IMAGE_TAG=0.39.0-nikolaik
