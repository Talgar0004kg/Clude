# ── Gemini API ──────────────────────────────────────────────
# Получить ключ: https://aistudio.google.com/app/apikey
LLM_API_KEY=your_gemini_api_key_here

# Модель (префикс gemini/ обязателен для LiteLLM)
LLM_MODEL=gemini/gemini-2.5-flash

# Оставьте пустым — Gemini не требует кастомного base_url
LLM_BASE_URL=

# ── Версии образов OpenHands ────────────────────────────────
# Актуальные теги: https://github.com/All-Hands-AI/OpenHands/releases
OPENHANDS_VERSION=latest
AGENT_SERVER_IMAGE_TAG=0.39.0-nikolaik
