# --- Ключ и модель LLM ---
# Получите ключ Gemini: https://aistudio.google.com/app/apikey
LLM_API_KEY=your_gemini_api_key_here

# Модель в формате LiteLLM. Для Google Gemini префикс gemini/.
# Примеры: gemini/gemini-2.5-flash, gemini/gemini-2.5-pro
LLM_MODEL=gemini/gemini-2.5-flash

# --- Версии образов OpenHands ---
# Актуальные версии: https://github.com/OpenHands/OpenHands/releases
OPENHANDS_VERSION=latest
AGENT_SERVER_IMAGE_REPOSITORY=ghcr.io/openhands/agent-server
AGENT_SERVER_IMAGE_TAG=1.19.1-python

# Порт веб-интерфейса OpenHands.
OPENHANDS_PORT=3000
