# ── Telegram ─────────────────────────────────────────────────
# Получить токен у @BotFather → /newbot или /token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Ваш Telegram user ID (узнать у @userinfobot). Пусто = без ограничений (небезопасно!)
ALLOWED_USER_IDS=123456789

# ── Локальная модель (Ollama) ────────────────────────────────
# Запуск сервера в соседней вкладке:  ollama serve
# Скачать модель:                     ollama pull llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Агент ────────────────────────────────────────────────────
AGENT_COMMAND_TIMEOUT=120
AGENT_MAX_STEPS=25
