# ── Telegram ─────────────────────────────────────────────────
# Получить токен у @BotFather → /newbot или /token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Ваш Telegram user ID (узнать у @userinfobot). Пусто = без ограничений (небезопасно!)
ALLOWED_USER_IDS=123456789

# ── Локальная LLM (Ollama) ────────────────────────────────────
# Сервер Ollama, запущенный локально: `ollama serve`
# Модель: `ollama pull llama3.2:3b`
OLLAMA_URL=http://localhost:11434/api/generate

# ── Агент ────────────────────────────────────────────────────
AGENT_MODEL=llama3.2:3b
AGENT_COMMAND_TIMEOUT=120
AGENT_MAX_STEPS=25
