# --- Telegram ---
# Токен бота от @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Разрешённые пользователи (ID через запятую). ОЧЕНЬ ВАЖНО для безопасности,
# т.к. бот выполняет команды. Узнать свой ID можно у @userinfobot.
# Если оставить пустым — бот ответит ВСЕМ (не рекомендуется).
ALLOWED_USER_IDS=

# --- Gemini ---
# Ключ Gemini API: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
AGENT_MODEL=gemini-2.5-flash

# --- Агент ---
# Базовая папка, внутри неё для каждого чата создаётся своя подпапка.
# AGENT_WORKSPACE=/абсолютный/путь
AGENT_COMMAND_TIMEOUT=120
AGENT_MAX_STEPS=25
